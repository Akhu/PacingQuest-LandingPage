---
const icon = (name: string) => `/images/pacingquest/optimized/${name}-128.webp`;

const points = [
  {
    title: 'Votre état en bref',
    description: "Jours depuis le dernier crash, dette de sommeil, activité la plus énergivore : l'essentiel en un coup d'œil.",
    icon: icon('balance_scale_3d'),
  },
  {
    title: "Des tendances jusqu'à 12 mois",
    description: 'Activités, symptômes, fatigue : voyez si la courbe monte ou descend, sans avoir à tout retenir.',
    icon: icon('person_climbing_3d_default'),
  },
  {
    title: 'Des données à partager',
    description: 'Exportez vos données au format CSV pour en parler avec votre médecin ou les relire à tête reposée.',
    icon: icon('floppy_disk_3d'),
  },
];

const screenshots = [
  {
    src: '/images/pacingquest/optimized/trends-512.webp',
    alt: "Écran Tendances : courbes d'activités, de symptômes et de fatigue sur les 12 derniers mois, avec une flèche indiquant si la tendance est en hausse ou en baisse.",
    glow: 'from-indigo-500 to-purple-500',
    offset: '',
  },
  {
    src: '/images/pacingquest/optimized/charts-512.webp',
    alt: "Écran Activités : intensité des activités mentales, physiques et émotionnelles jour par jour sur 6 mois, avec les crashs indiqués sur les courbes.",
    glow: 'from-purple-500 to-amber-500',
    offset: 'translate-y-10 sm:translate-y-0 sm:-mt-12',
  },
];
---

<section id="suivi" class="section relative overflow-hidden bg-gradient-to-b from-white via-indigo-50/30 to-indigo-50/50" aria-labelledby="suivi-title">
  <div class="parallax-blob absolute left-0 top-1/4 h-96 w-96 rounded-full bg-indigo-400/10 blur-3xl" aria-hidden="true"></div>
  <div class="parallax-blob absolute bottom-0 right-0 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="container relative mx-auto max-w-7xl">
    <div class="flex flex-col items-center gap-12 lg:flex-row lg:gap-16">
      <div class="space-y-8 lg:w-1/2">
        <div>
          <h2 id="suivi-title" class="mb-4 text-4xl font-semibold text-gray-900 md:text-5xl">
            <span class="text-gradient">Prenez du recul</span>{" "}<br />sur vos journées
          </h2>
          <p class="text-xl leading-relaxed text-gray-600">
            Vos saisies deviennent des graphiques lisibles, pour mieux voir ce qui vous coûte de l'énergie.
          </p>
        </div>

        <ul class="space-y-5" data-stagger>
          {points.map((point) => (
            <li class="glass-card flex gap-4 rounded-2xl p-5 transition-shadow duration-300 hover:shadow-lg" data-reveal>
              <div class="icon-tile h-14 w-14 rotate-3" aria-hidden="true">
                <img src={point.icon} alt="" width="40" height="40" class="h-10 w-10 -rotate-3 object-contain" loading="lazy" decoding="async" />
              </div>
              <div class="flex-1">
                <h3 class="mb-1 text-lg font-semibold text-gray-900 md:text-xl">{point.title}</h3>
                <p class="leading-relaxed text-gray-600">{point.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:w-1/2">
        <div class="relative">
          <div class="absolute inset-0 -rotate-6 rounded-3xl bg-gradient-to-br from-indigo-500/20 to-purple-500/20 blur-3xl" aria-hidden="true"></div>
          <div class="relative flex flex-row items-start justify-center gap-4 pb-10 sm:items-center sm:gap-6 sm:pb-0">
            {screenshots.map((shot) => (
              <figure class={`group relative w-[46%] max-w-64 sm:w-64 ${shot.offset}`}>
                <div class={`absolute -inset-1 rounded-3xl bg-gradient-to-r ${shot.glow} opacity-20 blur transition duration-500 group-hover:opacity-30`} aria-hidden="true"></div>
                <div class="relative w-full overflow-hidden rounded-2xl shadow-2xl transition-transform duration-500 hover:scale-105 sm:rounded-3xl">
                  <img src={shot.src} alt={shot.alt} width="512" height="1108" class="h-auto w-full" loading="lazy" decoding="async" />
                </div>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
