---
const points = [
  {
    title: "Prendre du recul sur son état quotidien",
    description: "Observez les tendances sur plusieurs semaines pour mieux comprendre votre santé.",
    icon: "/images/pacingquest/webp/balance_scale_3d.webp",
    iconAlt: "Balance scale"
  },
  {
    title: "Visualisez vos données, constatez les améliorations",
    description: "Des graphiques clairs qui montrent votre progression au fil du temps.",
    icon: "/images/pacingquest/webp/woman_in_lotus_position_3d_default.webp",
    iconAlt: "Person in lotus position"
  },
  {
    title: "Repérer des schémas pour adapter sa vie et remonter la pente",
    description: "Identifiez les facteurs qui influencent votre bien-être et ajustez votre quotidien.",
    icon: "/images/pacingquest/webp/person_climbing_3d_default.webp",
    iconAlt: "Person climbing"
  }
];
---

<section id="visualize" class="section relative overflow-hidden bg-gradient-to-b from-white via-indigo-50/30 to-indigo-50/50">
  <!-- Decorative elements -->
  <div class="parallax-blob absolute top-1/4 left-0 w-96 h-96 bg-indigo-400/10 rounded-full blur-3xl"></div>
  <div class="parallax-blob absolute bottom-0 right-0 w-96 h-96 bg-amber-400/10 rounded-full blur-3xl"></div>

  <div class="relative container mx-auto max-w-7xl">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Content Column -->
      <div class="lg:w-1/2 space-y-8 animate-on-scroll">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold mb-4">
            <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
              Visualisez
            </span>
            <br/>et comprenez
          </h2>
          <p class="text-xl text-gray-600 leading-relaxed">Identifiez ce qui vous aide et ce qui aggrave vos symptômes</p>
        </div>

        <div class="space-y-6" data-stagger>
          {points.map((point) => (
            <div class="flex gap-4 p-5 rounded-2xl glass-card hover:shadow-lg hover:-translate-x-2 transition-[box-shadow,translate] duration-300" data-reveal>
              <div class="shrink-0">
                <div class="relative flex h-14 w-14 items-center justify-center">
                  <div class="absolute inset-0 bg-gradient-to-br from-amber-200 to-amber-100 rounded-xl transform rotate-3 group-hover:rotate-6 transition-transform"></div>
                  <div class="relative p-2">
                    <img src={point.icon} alt={point.iconAlt} class="w-10 h-10 object-contain" loading="lazy" />
                  </div>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-lg md:text-xl font-semibold mb-1 text-gray-900">{point.title}</h3>
                <p class="text-gray-600 leading-relaxed">{point.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Images Column -->
      <div class="lg:w-1/2 animate-on-scroll animate-delay-1">
        <div class="relative">
          <!-- Decorative glow -->
          <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/20 to-purple-500/20 rounded-3xl blur-3xl transform -rotate-6"></div>

          <!-- Image Grid -->
          <div class="relative flex flex-col sm:flex-row items-center justify-center gap-6">
            <div class="relative group">
              <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-3xl opacity-20 group-hover:opacity-30 blur transition duration-500"></div>
              <div class="relative rounded-3xl overflow-hidden shadow-2xl w-56 sm:w-64 transform hover:scale-105 transition-transform duration-500">
                <img
                  src="/images/pacingquest/webp/Trends.webp"
                  alt="Graphiques de tendances dans l'application Pacing Quest"
                  class="w-full h-auto"
                  loading="lazy"
                />
              </div>
            </div>

            <div class="relative group sm:-mt-12">
              <div class="absolute -inset-1 bg-gradient-to-r from-purple-500 to-amber-500 rounded-3xl opacity-20 group-hover:opacity-30 blur transition duration-500"></div>
              <div class="relative rounded-3xl overflow-hidden shadow-2xl w-56 sm:w-64 transform hover:scale-105 transition-transform duration-500">
                <img
                  src="/images/pacingquest/webp/Charts.webp"
                  alt="Graphiques détaillés dans l'application Pacing Quest"
                  class="w-full h-auto"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
