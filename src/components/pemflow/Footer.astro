---
import {
  SITE_NAME,
  TAGLINE,
  LOGO_SRC,
  KOFI_URL,
  CREATOR,
  CONTACT_EMAIL,
  MEDICAL_DISCLAIMER,
} from '../../data/pacing-quest.js';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: "L'app",
    links: [
      { label: 'Fonctionnalités', href: '/#fonctionnalites' },
      { label: 'Confidentialité', href: '/#confidentialite' },
      { label: 'Mises à jour', href: '/mises-a-jour/' },
      { label: 'Questions fréquentes', href: '/#faq' },
    ],
  },
  {
    title: 'Soutenir',
    links: [
      { label: 'Faire un don sur Ko-fi', href: KOFI_URL },
      { label: "Pourquoi soutenir l'app ?", href: '/#soutenir' },
    ],
  },
  {
    title: 'Infos',
    links: [
      { label: "Conditions d'utilisation", href: '/cgu/' },
      { label: 'Nous écrire', href: `mailto:${CONTACT_EMAIL}` },
      { label: `Créé par ${CREATOR.name}`, href: CREATOR.url },
    ],
  },
];

const badges = ['Gratuite', 'Sans compte', 'Aucune donnée collectée'];
---

<footer class="on-dark relative overflow-hidden bg-gradient-to-b from-gray-900 to-gray-950 text-white">
  <div class="absolute left-0 top-0 h-96 w-96 rounded-full bg-indigo-600/10 blur-3xl" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-amber-600/10 blur-3xl" aria-hidden="true"></div>

  <div class="container relative mx-auto max-w-7xl px-4 py-16 md:px-8">
    <div class="mb-12 flex flex-col gap-12 lg:flex-row lg:justify-between">
      <div class="max-w-md text-center lg:text-left">
        <a href="/" class="mb-4 inline-flex items-center gap-3 rounded-xl">
          <img src={LOGO_SRC} alt="" width="40" height="40" class="h-10 w-10" loading="lazy" decoding="async" />
          <span class="font-title text-2xl font-semibold md:text-3xl">{SITE_NAME}</span>
        </a>
        <p class="mb-3 text-lg text-gray-300">{TAGLINE}.</p>
        <p class="text-gray-400">Journal de suivi quotidien pour iPhone, pensé pour le pacing, l'EM/SFC et le Covid long.</p>
      </div>

      <nav aria-label="Liens du pied de page" class="grid grid-cols-1 gap-10 text-center sm:grid-cols-3 sm:text-left">
        {columns.map((column) => (
          <div>
            <h2 class="mb-4 font-sans text-sm font-bold uppercase tracking-wider text-gray-300">{column.title}</h2>
            <ul class="space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="rounded text-gray-300 underline-offset-4 transition-colors hover:text-amber-300 hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <p class="mx-auto mb-10 max-w-3xl rounded-2xl border border-gray-800 bg-white/5 px-5 py-4 text-center text-sm leading-relaxed text-gray-400">
      {MEDICAL_DISCLAIMER} En cas de doute sur votre santé, parlez-en à votre médecin.
    </p>

    <div class="border-t border-gray-800/60 pt-8">
      <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
        <p class="text-sm text-gray-400">© 2022-{currentYear} {SITE_NAME} · {CREATOR.name}</p>
        <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-gray-400">
          {badges.map((badge) => (
            <li class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-sage-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              {badge}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
