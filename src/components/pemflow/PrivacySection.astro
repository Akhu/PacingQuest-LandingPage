---
// Each point is backed by the CGU or the App Store privacy label ("Données non collectées").
const privacyPoints = [
  {
    title: 'Aucun compte à créer',
    description: "Pas d'inscription, pas d'adresse e-mail à donner : vous ouvrez l'app et vous commencez.",
    icon: '<img src="/images/pacingquest/optimized/identification_card_3d-128.webp" alt="" width="40" height="40" class="h-10 w-10 object-contain" loading="lazy" decoding="async" />',
  },
  {
    title: 'Vos données restent sur votre iPhone',
    description: "Vos saisies sont enregistrées sur votre téléphone, pas sur un serveur. Si vous supprimez l'app, elles sont supprimées avec elle : pensez à les exporter avant.",
    icon: '<svg class="h-8 w-8 text-indigo-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path stroke-linecap="round" d="M10.5 18.5h3"/><path stroke-linecap="round" stroke-linejoin="round" d="M9.5 10.5V9a2.5 2.5 0 015 0v1.5m-5.5 0h6a.5.5 0 01.5.5v3a.5.5 0 01-.5.5H9a.5.5 0 01-.5-.5v-3a.5.5 0 01.5-.5z"/></svg>',
  },
  {
    title: 'Aucune donnée collectée',
    description: "La fiche App Store l'indique : « Données non collectées ». Pas de publicité, pas de pistage.",
    icon: '<svg class="h-8 w-8 text-indigo-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/></svg>',
  },
];
---

<section id="confidentialite" class="section relative overflow-hidden bg-gradient-to-b from-indigo-50/50 via-indigo-50 to-amber-50/30" aria-labelledby="confidentialite-title">
  <div class="parallax-blob absolute left-1/4 top-0 h-96 w-96 rounded-full bg-indigo-400/10 blur-3xl" aria-hidden="true"></div>
  <div class="parallax-blob absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="container relative mx-auto max-w-7xl">
    <div class="mb-14 text-center">
      <h2 id="confidentialite-title" class="section-title">
        La santé,
        <span class="relative inline-block">
          <span class="relative z-10">c'est privé</span>
          <span class="absolute bottom-2 left-0 h-3 w-full bg-indigo-300/30" aria-hidden="true"></span>
        </span>
      </h2>
      <p class="section-subtitle">Ce que vous notez dans Pacing Quest ne regarde que vous.</p>
    </div>

    <ul class="mx-auto max-w-4xl space-y-6" data-stagger>
      {privacyPoints.map((point) => (
        <li class="group relative" data-reveal>
          <div class="absolute -inset-0.5 rounded-3xl bg-gradient-to-r from-indigo-500 via-purple-500 to-amber-500 opacity-0 blur transition duration-500 group-hover:opacity-20" aria-hidden="true"></div>

          <div class="glass-card relative flex flex-col items-start gap-5 rounded-3xl border border-white/30 p-7 shadow-lg transition-shadow duration-500 hover:shadow-2xl sm:flex-row sm:items-center md:p-9">
            <div class="icon-tile h-16 w-16 transition-transform duration-500 group-hover:rotate-6" aria-hidden="true">
              <Fragment set:html={point.icon} />
            </div>

            <div class="flex-1">
              <h3 class="mb-2 text-xl font-semibold text-gray-900 md:text-2xl">{point.title}</h3>
              <p class="leading-relaxed text-gray-600">{point.description}</p>
            </div>

            <div class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sage-100 sm:flex" aria-hidden="true">
              <svg class="h-6 w-6 text-sage-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" focusable="false">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
