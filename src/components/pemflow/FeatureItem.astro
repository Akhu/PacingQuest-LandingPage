---
export interface Props {
  title: string;
  description: string;
  iconSrc: string;
}

const { title, description, iconSrc } = Astro.props;
---

<article class="group relative h-full">
  <div class="absolute -inset-0.5 rounded-3xl bg-gradient-to-r from-indigo-500 to-amber-500 opacity-0 blur transition duration-500 group-hover:opacity-20" aria-hidden="true"></div>

  <div class="glass-card relative flex h-full flex-row items-start gap-5 rounded-3xl border border-white/20 p-6 text-left transition-all duration-500 hover:-translate-y-1.5 hover:shadow-2xl sm:flex-col sm:items-center sm:gap-0 sm:p-8 sm:text-center md:p-9">
    <div class="relative flex h-16 w-16 shrink-0 items-center justify-center sm:mb-6 sm:h-20 sm:w-20" aria-hidden="true">
      <div class="absolute inset-0 rotate-6 rounded-2xl bg-gradient-to-br from-amber-200 to-amber-100 transition-transform duration-500 group-hover:rotate-12"></div>
      <div class="absolute inset-0 -rotate-6 rounded-2xl bg-gradient-to-br from-amber-100 to-amber-50 transition-transform duration-500 group-hover:-rotate-12"></div>
      <img src={iconSrc} alt="" width="56" height="56" class="relative h-11 w-11 object-contain transition-transform duration-500 group-hover:scale-110 sm:h-14 sm:w-14" loading="lazy" decoding="async" />
    </div>

    <div>
      <h3 class="mb-2 text-xl font-semibold text-gray-900 sm:mb-3 md:text-2xl">{title}</h3>
      <p class="leading-relaxed text-gray-600">{description}</p>
    </div>
  </div>
</article>
