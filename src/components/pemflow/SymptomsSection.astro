---
import PrimaryButton from '../global/PrimaryButton.astro';
const symptoms = [
  "Covid Long",
  "Syndrome post-viraux",
  "EM/SFC",
  "Encéphalomyélite myalgique",
  "Fatigue chronique",
  "Fibromyalgie",
  "Malaise post-effort",
  "Intolérance à l'effort",
  "Épuisement",
  "Épuisement chronique",
  "Brouillard mental",
  "Troubles cognitifs",
  "Douleurs chroniques",
  "Douleurs musculaires",
  "Douleurs articulaires",
  "Sommeil non réparateur",
  "Troubles du sommeil",
  "Intolérance orthostatique",
  "Hypotension",
  "POTS",
  "Tachycardie posturale",
  "Dysautonomie",
  "Palpitations",
  "Hypersensibilité sensorielle",
  "Anxiété",
  "Dépression réactionnelle",
  "Hypoxie cérébrale",
  "Gestion de l'énergie",
  "Auto-suivi des symptômes",
  "Suivi quotidien"
];
import AppStoreBadge from '../../assets/app_store_badge.svg';
---

<section class="section relative overflow-hidden bg-gradient-to-b from-amber-50/30 via-indigo-50 to-indigo-100/50">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-400/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-amber-400/10 rounded-full blur-3xl"></div>

  <div class="relative container mx-auto max-w-7xl">
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="section-title">
        Si ces mots<br/>
        <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-amber-500 bg-clip-text text-transparent">
          vous parlent...
        </span>
      </h2>
      <p class="section-subtitle">Pacing Quest est conçue pour vous aider à gérer ces conditions</p>
    </div>

    <!-- Symptom Tags -->
    <div class="flex flex-wrap justify-center gap-3 max-w-5xl mx-auto mb-16 animate-on-scroll animate-delay-1">
      {symptoms.map((symptom, index) => (
        <span
          class="group relative px-5 py-2.5 rounded-full text-sm md:text-base font-medium transition-all duration-300 hover:-translate-y-1 cursor-default"
          style={`animation: fade-in 0.5s ease-out ${index * 0.05}s backwards;`}
        >
          <!-- Background gradient that shows on hover -->
          <span class="absolute inset-0 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>

          <!-- Glass background -->
          <span class="absolute inset-0 rounded-full glass-card border border-indigo-200/50 group-hover:border-indigo-300/50 transition-colors"></span>

          <!-- Text -->
          <span class="relative text-gray-700 group-hover:text-white transition-colors font-medium">
            {symptom}
          </span>
        </span>
      ))}
    </div>

    <!-- CTA Section -->
    <div class="text-center animate-on-scroll animate-delay-2">
      <div class="inline-block p-8 md:p-12 rounded-3xl glass-card shadow-2xl border border-white/30">
        <p class="text-xl md:text-2xl text-gray-700 mb-8 font-medium max-w-2xl">
          Rejoignez des milliers de personnes qui reprennent le contrôle de leur santé
        </p>

        <div class="flex flex-col items-center space-y-6">
          <PrimaryButton url="https://apps.apple.com/fr/app/pacing-quest/id6499503099">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              Télécharger l'application
            </span>
          </PrimaryButton>

          <a
            href="https://apps.apple.com/fr/app/pacing-quest/id6499503099"
            class="opacity-90 hover:opacity-100 transition-opacity transform hover:scale-105 duration-300"
            aria-label="Télécharger sur l'App Store"
          >
            <AppStoreBadge/>
          </a>

          <p class="text-sm text-gray-500">
            <svg class="inline w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            100% gratuit · Disponible sur iOS
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
