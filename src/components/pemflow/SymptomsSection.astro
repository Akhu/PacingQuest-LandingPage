---
import AppStoreCta from './AppStoreCta.astro';
import { CREATOR, MIN_IOS_VERSION } from '../../data/pacing-quest.js';

const keywords = [
  'Covid long',
  'EM/SFC',
  'Encéphalomyélite myalgique',
  'Fatigue chronique',
  'Syndrome post-viral',
  'Malaise post-effort',
  'Crashs',
  'Intolérance à l’effort',
  'Brouillard mental',
  'Sommeil non réparateur',
  'Douleurs chroniques',
  'Fibromyalgie',
  'Dysautonomie',
  'POTS',
  'Gestion de l’énergie',
  'Pacing',
];
---

<section id="pour-qui" class="section relative overflow-hidden bg-gradient-to-b from-amber-50/30 via-indigo-50 to-indigo-100/50" aria-labelledby="pour-qui-title">
  <div class="parallax-blob absolute right-0 top-0 h-96 w-96 rounded-full bg-indigo-400/10 blur-3xl" aria-hidden="true"></div>
  <div class="parallax-blob absolute bottom-0 left-0 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="container relative mx-auto max-w-7xl">
    <div class="mb-12 text-center">
      <h2 id="pour-qui-title" class="section-title">
        Si ces mots<br />
        <span class="text-gradient">vous parlent…</span>
      </h2>
      <p class="section-subtitle">
        Pacing Quest a été pensée pour les personnes qui doivent composer avec leur énergie au quotidien.
      </p>
    </div>

    <ul class="mx-auto mb-16 flex max-w-5xl flex-wrap justify-center gap-3">
      {keywords.map((keyword, index) => (
        <li
          class="keyword-tag glass-card rounded-full border border-indigo-200/60 px-5 py-2.5 text-sm font-semibold text-gray-700 md:text-base"
          style={`animation-delay: ${index * 0.04}s;`}
        >
          {keyword}
        </li>
      ))}
    </ul>

    <div class="mx-auto mb-16 max-w-3xl rounded-3xl border border-white/40 bg-white/70 p-7 text-center shadow-lg md:p-9">
      <h3 class="mb-3 font-sans text-sm font-bold uppercase tracking-wider text-indigo-700">Qui est derrière l'app ?</h3>
      <p class="font-title text-xl leading-relaxed text-gray-800 md:text-2xl">
        Pacing Quest est conçue par <a href={CREATOR.url} class="text-link">{CREATOR.name}</a>, développeur indépendant, lui-même concerné par le Covid long.
      </p>
    </div>

    <div class="text-center">
      <div class="glass-card inline-block rounded-3xl border border-white/30 p-8 shadow-2xl md:p-12">
        <h3 class="mx-auto mb-3 max-w-2xl text-2xl font-semibold text-gray-900 md:text-3xl">
          Commencez quand vous voulez, à votre rythme
        </h3>
        <p class="mx-auto mb-8 max-w-xl text-lg text-gray-600">
          Gratuite, sans compte, pour iPhone (iOS {MIN_IOS_VERSION} ou plus récent).
        </p>
        <AppStoreCta />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes tag-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .keyword-tag {
    animation: tag-in 0.5s ease-out backwards;
  }
</style>
