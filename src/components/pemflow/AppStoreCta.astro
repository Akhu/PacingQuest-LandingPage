---
import { APP_STORE_URL, KOFI_URL } from '../../data/pacing-quest.js';

export interface Props {
  showSupport?: boolean;
}

const { showSupport = false } = Astro.props;
---

<div class="flex flex-col items-center gap-5">
  <div class="flex flex-col items-center gap-3 sm:flex-row">
    <a href={APP_STORE_URL} class="btn btn-primary btn-magnetic px-7">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19h14" />
      </svg>
      Télécharger l'application
    </a>
    {showSupport && (
      <a href={KOFI_URL} class="btn btn-secondary btn-magnetic">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
        </svg>
        Soutenir avec un café
      </a>
    )}
  </div>

  <a href={APP_STORE_URL} class="inline-block rounded-xl opacity-95 transition hover:scale-105 hover:opacity-100">
    <img
      src="/images/pacingquest/app_store_badge.svg"
      alt="Télécharger dans l'App Store"
      width="152"
      height="48"
      class="h-12 w-auto"
      loading="lazy"
    />
  </a>
</div>
