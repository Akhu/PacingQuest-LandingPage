---
import FeatureItem from './FeatureItem.astro';

const features = [
  {
    title: "Notez simplement la qualité de sommeil",
    iconSrc: "/images/pacingquest/webp/person_in_bed_3d_default.webp",
    description: "Suivez facilement votre sommeil pour identifier les tendances et améliorations."
  },
  {
    title: "Exprimez les activités sur une échelle simple et officielle",
    iconSrc: "/images/pacingquest/webp/kite_3d.webp",
    description: "Utilisez une échelle imaginée pour le Pacing par Stanford (USA) pour mesurer votre niveau d'activité quotidien.",
    link: "/Outil_PlanEvitementCrash_Stanford_FR.pdf"
  },
  {
    title: "Prendre note des crashes et de vos symptômes",
    iconSrc: "/images/pacingquest/webp/card_file_box_3d.webp",
    description: "Documentez vos symptômes et les moments difficiles pour mieux les comprendre."
  }
];
---

<section id="features" class="section relative overflow-hidden">
  <!-- Gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-amber-50/50 via-white to-white"></div>

  <!-- Decorative elements -->
  <div class="parallax-blob absolute top-20 right-0 w-72 h-72 bg-amber-300/10 rounded-full blur-3xl"></div>
  <div class="parallax-blob absolute bottom-0 left-0 w-96 h-96 bg-indigo-300/10 rounded-full blur-3xl"></div>

  <div class="relative container mx-auto max-w-7xl">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="section-title">
        Prendre en main<br/>
        <span class="bg-gradient-to-r from-indigo-600 to-amber-500 bg-clip-text text-transparent">
          sa guérison
        </span>
      </h2>
      <p class="section-subtitle">Des outils simples mais puissants pour suivre vos symptômes</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10" data-stagger>
      {features.map((feature) => (
        <div data-reveal>
          <FeatureItem
            title={feature.title}
            iconSrc={feature.iconSrc}
            description={feature.description}
            link={feature.link}
          />
        </div>
      ))}
    </div>
  </div>
</section>
