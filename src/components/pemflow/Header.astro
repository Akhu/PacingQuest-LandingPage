---
import PrimaryButton from '../global/PrimaryButton.astro';
import AppStoreBadge from '../../assets/app_store_badge.svg';
import SecondaryButton from '../global/SecondaryButton.astro';
---

<header class="relative min-h-screen gradient-mesh overflow-hidden">
  <!-- Decorative gradient orbs -->
  <div class="parallax-blob absolute top-0 left-0 w-96 h-96 bg-indigo-400/20 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
  <div class="parallax-blob absolute bottom-0 right-0 w-96 h-96 bg-amber-400/20 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>

  <!-- Navigation (sticky frosted) -->
  <nav id="site-header" class="fixed top-0 left-0 right-0 z-50 px-4 md:px-8 py-4 md:py-5">
    <div class="container mx-auto max-w-7xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center space-x-3 animate-on-scroll">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-amber-500 rounded-2xl blur opacity-40"></div>
          <img src="/assets/PemFlow_logo.png" alt="Pacing Quest Logo" class="relative h-12 md:h-14 drop-shadow-lg" />
        </div>
        <div class="text-gray-900 font-bold text-2xl md:text-3xl tracking-tight">Pacing Quest</div>
      </div>

      <div class="flex space-x-8 animate-on-scroll animate-delay-1">
        <a href="#features" class="text-gray-700 hover:text-indigo-600 transition-colors font-medium relative group">
          Fonctionnalités
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-600 transition-all group-hover:w-full"></span>
        </a>
        <a href="#visualize" class="text-gray-700 hover:text-indigo-600 transition-colors font-medium relative group">
          Visualiser
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-600 transition-all group-hover:w-full"></span>
        </a>
        <a href="#privacy" class="text-gray-700 hover:text-indigo-600 transition-colors font-medium relative group">
          Confidentialité
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-indigo-600 transition-all group-hover:w-full"></span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Content -->
  <div class="relative z-10 container mx-auto px-4 md:px-8 max-w-7xl">
    <div class="flex flex-col items-center justify-center min-h-screen text-center pt-28 pb-16 md:pt-32 md:pb-20">

      <!-- Main Heading -->
      <div class="space-y-6 mb-12 animate-on-scroll animate-delay-2">
        <div class="inline-block">
          <div class="relative">
            <h1 class="text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-bold text-gray-900 leading-tight">
              La quête vers<br/>
              <span class="relative inline-block">
                <span class="relative z-10 bg-gradient-to-r from-indigo-600 via-purple-600 to-amber-500 bg-clip-text text-transparent">
                  la guérison
                </span>
                <span class="absolute bottom-2 left-0 w-full h-4 bg-amber-200/40 -z-10"></span>
              </span>
            </h1>
          </div>
        </div>

        <p class="text-xl md:text-2xl lg:text-3xl text-gray-600 max-w-4xl mx-auto font-light leading-relaxed">
          L'application <strong class="font-semibold text-gray-800">100% gratuite</strong> par les patients, pour les patients<br class="hidden md:block"/>
          pour reprendre le dessus sur la maladie et adapter sa vie.
        </p>
      </div>

      <!-- App Preview -->
      <div class="relative mb-12 animate-on-scroll animate-delay-3">
        <div class="absolute inset-0 bg-gradient-to-t from-indigo-500/30 to-amber-500/30 rounded-[3rem] blur-2xl transform scale-95"></div>
        <div class="relative w-72 md:w-96 lg:w-[28rem] mx-auto transform hover:scale-105 transition-transform duration-500" style="animation: float 6s ease-in-out infinite;">
          <img
            src="/images/pacingquest/webp/Hero.webp"
            alt="Interface de l'application Pacing Quest"
            class="w-full h-auto drop-shadow-2xl rounded-3xl"
            loading="eager"
          />
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col items-center space-y-6 animate-on-scroll animate-delay-4">
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <PrimaryButton url="https://apps.apple.com/fr/app/pacing-quest/id6499503099">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              Télécharger l'application
            </span>
          </PrimaryButton>
          <SecondaryButton url="https://ko-fi.com/anthonyswift">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
              </svg>
              Soutenir avec un café
            </span>
          </SecondaryButton>
        </div>

        <a
          href="https://apps.apple.com/fr/app/pacing-quest/id6499503099"
          class="opacity-90 hover:opacity-100 transition-opacity transform hover:scale-105 duration-300"
          aria-label="Télécharger sur l'App Store"
        >
          <AppStoreBadge/>
        </a>
      </div>

    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</header>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
  }
</style>
