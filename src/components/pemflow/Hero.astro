---
import AppStoreCta from './AppStoreCta.astro';
import { MIN_IOS_VERSION, latestRelease } from '../../data/pacing-quest.js';

const highlights = ['Gratuite', 'Sans compte', 'Données sur votre iPhone', `iOS ${MIN_IOS_VERSION} ou plus récent`];
const heroSizes = [480, 600, 720, 960];
---

<section class="gradient-mesh relative overflow-hidden" aria-labelledby="hero-title">
  <div class="parallax-blob absolute left-0 top-0 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-indigo-400/20 blur-3xl" aria-hidden="true"></div>
  <div class="parallax-blob absolute bottom-0 right-0 h-96 w-96 translate-x-1/3 translate-y-1/3 rounded-full bg-amber-400/20 blur-3xl" aria-hidden="true"></div>

  <div class="container relative z-10 mx-auto flex max-w-7xl flex-col items-center px-4 pb-16 pt-28 text-center md:px-8 md:pb-24 md:pt-36">
    <a
      href="/mises-a-jour/"
      class="animate-on-scroll mb-8 inline-flex items-center gap-2 rounded-full border border-indigo-200/70 bg-white/70 py-1.5 pl-1.5 pr-4 text-sm font-semibold text-gray-700 shadow-sm backdrop-blur transition hover:bg-white hover:text-indigo-700"
    >
      <span class="rounded-full bg-indigo-600 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-white">v{latestRelease.version}</span>
      <span>Dernière version : {latestRelease.title.toLowerCase()}</span>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <h1 id="hero-title" class="animate-rise max-w-5xl text-5xl font-semibold leading-[1.05] text-gray-900 sm:text-6xl lg:text-7xl xl:text-8xl">
      Suivez vos symptômes
      <span class="relative inline-block">
        <span class="text-gradient relative z-10 pb-1">à votre rythme</span>
        <span class="absolute bottom-1 left-0 -z-0 h-3 w-full rounded-full bg-amber-200/50 md:bottom-2 md:h-4" aria-hidden="true"></span>
      </span>
    </h1>

    <p class="animate-rise mt-7 max-w-3xl text-lg leading-relaxed text-gray-700 md:text-2xl">
      Pacing Quest est un journal de suivi quotidien pour iPhone, pensé pour le pacing, l'EM/SFC et le Covid long.
      Notez votre fatigue, vos activités et vos symptômes en quelques gestes, puis prenez du recul grâce à des graphiques simples.
    </p>

    <ul class="animate-on-scroll animate-delay-2 mt-8 flex flex-wrap justify-center gap-2" aria-label="En bref">
      {highlights.map((item) => (
        <li class="inline-flex items-center gap-1.5 rounded-full bg-white/75 px-3.5 py-1.5 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-200">
          <svg class="h-4 w-4 text-sage-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 01.006 1.414l-7.25 7.3a1 1 0 01-1.42 0l-3.75-3.775a1 1 0 111.42-1.41l3.04 3.06 6.54-6.585a1 1 0 011.414-.004z" clip-rule="evenodd" />
          </svg>
          {item}
        </li>
      ))}
    </ul>

    <div class="animate-on-scroll animate-delay-3 mt-10">
      <AppStoreCta showSupport />
    </div>

    <div class="animate-rise relative mt-14 w-full max-w-[18rem] md:max-w-[24rem] lg:max-w-[28rem]">
      <div class="absolute inset-0 scale-95 rounded-[3rem] bg-gradient-to-t from-indigo-500/30 to-amber-500/30 blur-2xl" aria-hidden="true"></div>
      <img
        src={`/images/pacingquest/optimized/hero-${heroSizes[2]}.webp`}
        srcset={heroSizes.map((w) => `/images/pacingquest/optimized/hero-${w}.webp ${w}w`).join(', ')}
        sizes="(min-width: 1024px) 448px, (min-width: 768px) 384px, 288px"
        width="960"
        height="752"
        alt="Deux écrans de Pacing Quest : les tendances d'activités, de symptômes et de fatigue, et la saisie de la journée avec la météo du jour et le niveau de fatigue."
        class="animate-float relative h-auto w-full drop-shadow-2xl"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>
