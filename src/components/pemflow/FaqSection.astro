---
import { faq } from '../../data/pacing-quest.js';
---

<section id="faq" class="section relative overflow-hidden bg-gradient-to-b from-amber-50/40 via-white to-white" aria-labelledby="faq-title">
  <div class="container relative mx-auto max-w-3xl">
    <div class="mb-12 text-center">
      <h2 id="faq-title" class="section-title">Questions fréquentes</h2>
      <p class="section-subtitle mb-0">Ce que l'app fait, ce qu'elle ne fait pas, et comment elle traite vos données.</p>
    </div>

    <div class="space-y-3">
      {faq.map(({ id, question, answer }) => (
        <details id={id} class="faq-item group rounded-2xl border border-gray-200 bg-white/80 shadow-sm transition-shadow open:shadow-md">
          <summary class="flex items-center justify-between gap-4 rounded-2xl px-5 py-4 text-left md:px-6 md:py-5">
            <h3 class="font-sans text-lg font-bold leading-snug tracking-normal text-gray-900 md:text-xl">{question}</h3>
            <svg class="faq-chevron h-5 w-5 shrink-0 text-indigo-700 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="prose-answer px-5 pb-5 text-gray-700 md:px-6 md:pb-6" set:html={answer} />
        </details>
      ))}
    </div>
  </div>
</section>
