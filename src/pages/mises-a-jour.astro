---
export const prerender = true;
import PEMFlowLayout from '../layouts/PEMFlowLayout.astro';
import AppStoreCta from '../components/pemflow/AppStoreCta.astro';
import { SITE_NAME, KOFI_URL, releases, latestRelease, formatDate } from '../data/pacing-quest.js';

const title = `Mises à jour – Les nouveautés de ${SITE_NAME}`;
const description = `Historique des versions de ${SITE_NAME}, l'app iPhone de suivi des symptômes. Dernière version : ${latestRelease.version} (${formatDate(latestRelease.date)}).`;

const siteUrl = Astro.site!.href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Mises à jour', item: new URL('/mises-a-jour/', siteUrl).href },
    ],
  },
];
---

<PEMFlowLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="gradient-mesh relative px-4 pb-12 pt-32 md:px-8 md:pb-16 md:pt-40" aria-labelledby="updates-title">
    <div class="container relative z-10 mx-auto max-w-3xl text-center">
      <p class="mb-4 text-sm font-bold uppercase tracking-wider text-indigo-700">Journal des versions</p>
      <h1 id="updates-title" class="mb-5 text-5xl font-semibold text-gray-900 md:text-6xl">
        Mises <span class="text-gradient">à jour</span>
      </h1>
      <p class="text-lg text-gray-700 md:text-xl">
        Les nouveautés de {SITE_NAME}, version après version. Les mises à jour arrivent directement par l'App Store.
      </p>
    </div>
  </section>

  <section class="px-4 pb-20 md:px-8 md:pb-28" aria-label="Historique des versions">
    <ol class="relative mx-auto max-w-3xl space-y-8 border-l-2 border-indigo-200 pl-6 md:pl-10">
      {releases.map((release, index) => (
        <li class="relative">
          <span
            class={`absolute -left-[2.1rem] top-7 flex h-4 w-4 items-center justify-center rounded-full ring-4 ring-[#fdf8f2] md:-left-[3.1rem] ${index === 0 ? 'bg-indigo-600' : 'bg-indigo-300'}`}
            aria-hidden="true"
          ></span>
          <article class="glass-card rounded-3xl border border-white/40 p-6 shadow-lg md:p-8" aria-labelledby={`version-${release.version}`}>
            <header class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
              <h2 id={`version-${release.version}`} class="text-2xl font-semibold text-gray-900 md:text-3xl">
                Version {release.version}
              </h2>
              {index === 0 && (
                <span class="rounded-full bg-sage-100 px-3 py-1 text-sm font-bold text-sage-800">Dernière version</span>
              )}
              <time datetime={release.date} class="w-full text-gray-600 sm:ml-auto sm:w-auto">
                {formatDate(release.date)}
              </time>
            </header>
            <p class="mb-3 text-lg font-semibold text-indigo-700">{release.title}</p>
            <ul class="prose-answer text-gray-700">
              {release.notes.map((note) => <li>{note}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>

    <div class="mx-auto mt-16 max-w-3xl rounded-3xl border border-white/40 bg-white/70 p-8 text-center shadow-lg md:p-10">
      <h2 class="mb-3 text-2xl font-semibold text-gray-900 md:text-3xl">Pas encore l'app ?</h2>
      <p class="mb-8 text-gray-600">Gratuite, sans compte, pour iPhone.</p>
      <AppStoreCta />
      <p class="mt-8 text-gray-600">
        Ces évolutions vous sont utiles ? Vous pouvez <a href={KOFI_URL} class="text-link">soutenir le projet sur Ko-fi</a>, sans aucune obligation.
      </p>
    </div>
  </section>
</PEMFlowLayout>
