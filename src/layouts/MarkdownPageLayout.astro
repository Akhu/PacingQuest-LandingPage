---
export const prerender = true;
import PEMFlowLayout from './PEMFlowLayout.astro';
import { SITE_NAME } from '../data/pacing-quest.js';

const { frontmatter } = Astro.props;
---

<PEMFlowLayout title={`${frontmatter.title} – ${SITE_NAME}`} description={frontmatter.seoDescription ?? frontmatter.description}>
  <article class="px-4 pb-20 pt-32 md:px-8 md:pb-28 md:pt-40">
    <header class="mx-auto mb-10 max-w-prose">
      <h1 class="mb-4 text-4xl font-semibold text-gray-900 md:text-5xl">{frontmatter.title}</h1>
      <p class="rounded-2xl bg-white/70 px-4 py-3 text-gray-600 ring-1 ring-inset ring-gray-200">{frontmatter.description}</p>
    </header>

    <div class="prose prose-lg mx-auto prose-headings:font-title prose-headings:text-gray-900 prose-a:text-indigo-700 prose-strong:text-gray-900">
      <slot />
    </div>
  </article>
</PEMFlowLayout>
