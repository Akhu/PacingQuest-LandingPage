---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import SiteNav from '../components/pemflow/SiteNav.astro';
import Footer from '../components/pemflow/Footer.astro';
import { SITE_NAME, CREATOR, OG_IMAGE } from '../data/pacing-quest.js';

export interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(OG_IMAGE.src, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={CREATOR.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fdf8f2" />
    <!-- iOS Safari smart banner pointing to the App Store listing -->
    <meta name="apple-itunes-app" content="app-id=6499503099" />

    <!-- Progressive enhancement: only hide scroll-reveal content when JS is alive -->
    <script is:inline>document.documentElement.classList.add('js')</script>

    <!-- Self-hosted fonts (no third-party request) -->
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="antialiased">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <div id="scroll-progress" aria-hidden="true"></div>
    <SiteNav />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script is:inline src="/scripts/animations.js" defer></script>
  </body>
</html>
